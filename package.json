{
  "name": "nightlight-launcher",
  "version": "5.2.9",
  "description": "Nightlight Launcher – Play for free",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "electron-builder"
  },
  "author": "OnajLikezz",
  "license": "MIT",
  "build": {
    "appId": "com.nightlight.launcher",
    "productName": "Nightlight Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "mac": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "fs-extra": "^11.4.0",
    "node-fetch": "^3.3.2",
    "node-stream-zip": "^1.16.0",
    "steam-user": "^4.28.1",
    "systeminformation": "^5.22.0",
    "temp": "^0.9.4"
  }
}
